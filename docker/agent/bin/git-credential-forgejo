# git's credential helper for the forge: the agent's own account and token. What the
# token may do is decided by the forge's permissions, not here.
[ "${1:-}" = get ] || exit 0
echo "username=${AGENT_NAME:?}"
echo "password=$(tr -d '[:space:]' < "${TOKEN_FILE:-/run/secrets/forgejo_token}")"
