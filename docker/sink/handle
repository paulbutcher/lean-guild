# One HTTP request on stdin: a POST to /hook is recorded in /state/events.jsonl.
set -u
read -r method path _
length=0 event=""
while IFS= read -r line; do
  line="${line%$'\r'}"
  [ -z "$line" ] && break
  case "${line,,}" in
    content-length:*) length="${line#*: }" ;;
    x-forgejo-event:*) event="${line#*: }" ;;
  esac
done
[ "$length" -gt 0 ] 2>/dev/null && head -c "$length" >/dev/null
if [ "$method" = POST ] && [ "$path" = /hook ]; then
  printf '{"at": "%s", "type": "%s"}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$event" >> /state/events.jsonl
fi
printf 'HTTP/1.1 200 OK\r\nContent-Length: 0\r\nConnection: close\r\n\r\n'
