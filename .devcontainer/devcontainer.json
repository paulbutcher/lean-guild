{
	"name": "Ubuntu",
	"build": { "dockerfile": "Dockerfile" },

  // A Docker engine of this container's own, for building and testing the kit, separate from the
  // host's, which runs a production kit. Moby has no packages for Ubuntu resolute, so this installs
  // Docker CE from Docker's own repository.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": false }
  },

  // Store Claude's persistent state on the host
  "mounts": [
    "source=${localEnv:HOME}/.claude-devcontainer,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=elan-shared,target=/home/vscode/.elan,type=volume"
  ],

  // The reference is cloned beside the workspace. /workspaces is mounted at run time, as root's, so a chown in the Dockerfile would be hidden.
  "postCreateCommand": "sudo chown vscode:vscode /workspaces",

  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "${containerWorkspaceFolder}"
  },

	"customizations": {
		"vscode": {
			"extensions": ["leanprover.lean4", "anthropic.claude-code"]
		}
	}
}
